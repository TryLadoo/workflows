        "prompt": "Offer two open times and book the one the caller picks.",
        "then": "goodbye",
        "on_error": "message"
      },
      {
        "id": "urgent",
        "type": "action",
        "name": "Flag the emergency",
        "action": "flag_urgent",
        "then": "message"
      },
      {
        "id": "message",
        "type": "action",
        "name": "Take a message",
        "action": "take_message",
        "prompt": "Take the caller's name and what they need.",
        "then": "goodbye"
      },
      { "id": "goodbye", "type": "end", "name": "Say goodbye", "message": "" }
    ],
    "global_edges": [{ "to": "urgent", "when": { "intent": "describes a burst pipe, flooding or a gas smell" } }]
  },
  "layout": {
