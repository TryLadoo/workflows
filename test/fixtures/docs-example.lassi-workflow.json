{
  "format": "lassi.workflow",
  "format_version": 1,
  "name": "Rivera Plumbing front desk",
  "description": "Books visits and takes messages. Emergencies are flagged urgent.",
  "graph": {
    "start": "greet",
    "nodes": [
      {
        "id": "greet",
        "type": "conversation",
        "name": "Find out why they're calling",
        "prompt": "Find out what the caller needs.",
        "edges": [
          { "to": "details", "when": { "intent": "wants a plumber to come out" } },
          { "to": "message", "when": { "else": true } }
        ]
      },
      {
        "id": "details",
        "type": "collect",
        "name": "Get the job details",
        "prompt": "Get the details for the visit.",
        "fields": ["service_address", "problem"],
        "then": "book"
      },
      {
        "id": "book",
        "type": "action",
        "name": "Book the visit",
